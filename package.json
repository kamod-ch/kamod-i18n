{
  "name": "kamod-i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepublishOnly": "node -e \"console.error('Do not publish the workspace root. Use: pnpm publish:core'); process.exit(1)\"",
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @kamod-ch/i18n build",
    "docs:dev": "pnpm --filter @kamod-ch/i18n-docs dev",
    "dev:docs": "pnpm docs:dev",
    "docs:build": "pnpm --filter @kamod-ch/i18n-docs build",
    "build:docs": "pnpm docs:build",
    "docs:check": "pnpm --filter @kamod-ch/i18n-docs check",
    "check:docs": "pnpm docs:check",
    "docs:preview": "pnpm --filter @kamod-ch/i18n-docs preview",
    "preview:docs": "pnpm docs:preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @kamod-ch/i18n test",
    "typecheck:core": "pnpm --filter @kamod-ch/i18n typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm docs:check",
    "pack:core": "pnpm --filter @kamod-ch/i18n exec npm pack --dry-run",
    "publish:core": "pnpm --filter @kamod-ch/i18n publish --access public",
    "release:check": "pnpm verify",
    "release:publish": "pnpm --filter @kamod-ch/i18n publish --access public --provenance --no-git-checks",
    "release": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "release:dry": "node ./scripts/release.mjs patch --dry",
    "brand:readme": "kamod-brand-readme --product i18n --output .github/assets"
  },
  "devDependencies": {
    "@kamod-ch/brand": "^0.4.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "preact": "^11.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
