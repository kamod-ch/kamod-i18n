{
  "name": "@kamod-ch/i18n",
  "version": "0.1.0",
  "description": "Type-safe, Preact-native internationalization with zero runtime dependencies.",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "preact",
    "typescript",
    "intl",
    "translations",
    "tree-shakeable",
    "ssr",
    "kamod"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://kamod-ch.github.io/kamod-i18n/",
  "bugs": {
    "url": "https://github.com/kamod-ch/kamod-i18n/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/kamod-i18n.git",
    "directory": "packages/i18n"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preact": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "preact": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": { "optional": true }
  },
  "scripts": {
    "build": "tsup src/index.ts src/preact.ts --format esm --dts --sourcemap --clean",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
